# Agent Ops Console — 服务端环境变量示例
# 复制为 .env 后修改

# 应用级凭据加密密钥 (AES-256-GCM)
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AOC_SECRET=replace-with-a-64-char-hex-string

# 服务监听
AOC_PORT=3001
AOC_HOST=127.0.0.1

# SQLite 数据库路径 (可选, 默认 server/data.db)
# AOC_DB_PATH=./data.db

# CORS 来源 (开发时默认全部允许)
AOC_CORS_ORIGIN=true
